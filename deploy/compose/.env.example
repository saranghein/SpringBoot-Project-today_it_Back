# 배포 이미지. 운영에서는 변경 불가능한 Git commit SHA 태그를 사용합니다.
API_IMAGE=ghcr.io/saranghein/todayit-api:dev
DATA_WORKER_IMAGE=ghcr.io/saranghein/todayit-data-worker:dev

# 최초 인증서 발급 전에는 bootstrap, 발급 후에는 https를 사용합니다.
NGINX_CONFIG=bootstrap
PUBLIC_IP=203.0.113.10
LETSENCRYPT_EMAIL=admin@example.com

# Lightsail 개발 서버의 영속 데이터 경로입니다. 로컬 검증 시 ./data로 바꿀 수 있습니다.
DATA_ROOT=/opt/todayit/data

POSTGRES_DB=todayit
POSTGRES_USER=todayit_app
POSTGRES_DB_SCHEMA=todayit
POSTGRES_PASSWORD=replace-with-a-strong-password
REDIS_PASSWORD=replace-with-a-strong-password

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_EXPIRATION=30m
CORS_ALLOWED_ORIGIN=http://localhost:5173
OPENAPI_ENABLED=true
