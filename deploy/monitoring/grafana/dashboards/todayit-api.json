{
  "schemaVersion": 39,
  "time": {
    "to": "now",
    "from": "now-1h"
  },
  "version": 2,
  "panels": [
    {
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "displayName": "수집 상태",
          "mappings": [
            {
              "options": {
                "1": {
                  "text": "정상",
                  "color": "green"
                },
                "0": {
                  "text": "수집 실패",
                  "color": "red"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "y": 0,
        "w": 12,
        "h": 8,
        "x": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"todayit-api\"}",
          "legendFormat": "수집 상태"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "API 수집 상태",
      "description": "Prometheus가 API 메트릭을 수집할 수 있는지 표시합니다. 정상은 수집 가능, 실패는 수집 불가입니다.",
      "options": {
        "legend": {
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table"
        },
        "tooltip": {
          "sort": "none",
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "displayName": "초당 요청 수"
        },
        "overrides": []
      },
      "gridPos": {
        "y": 0,
        "w": 12,
        "h": 8,
        "x": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"todayit-api\"}[5m]))",
          "legendFormat": "초당 요청 수"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "초당 HTTP 요청 수",
      "description": "최근 5분을 기준으로 계산한 초당 평균 HTTP 요청 수입니다.",
      "options": {
        "legend": {
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table"
        },
        "tooltip": {
          "sort": "none",
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "displayName": "초당 서버 오류 수"
        },
        "overrides": []
      },
      "gridPos": {
        "y": 8,
        "w": 12,
        "h": 8,
        "x": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"todayit-api\",status=~\"5..\"}[5m]))",
          "legendFormat": "초당 서버 오류 수"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "초당 서버 오류 수 (5xx)",
      "description": "최근 5분을 기준으로 계산한 초당 평균 서버 오류(HTTP 5xx) 수입니다. 오류 응답이 아직 없으면 데이터가 표시되지 않을 수 있습니다.",
      "options": {
        "legend": {
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table"
        },
        "tooltip": {
          "sort": "none",
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "displayName": "평균 응답 시간",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "y": 8,
        "w": 12,
        "h": 8,
        "x": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_sum{job=\"todayit-api\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"todayit-api\"}[5m])), 0.000001)) * 1000",
          "legendFormat": "평균 응답 시간"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "평균 HTTP 응답 시간",
      "description": "최근 5분 동안 처리한 HTTP 요청 한 건의 평균 소요 시간입니다. 1,000ms는 1초입니다. 요청이 없으면 0으로 표시될 수 있습니다.",
      "options": {
        "legend": {
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table"
        },
        "tooltip": {
          "sort": "none",
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "displayName": "힙 메모리 사용량"
        },
        "overrides": []
      },
      "gridPos": {
        "y": 16,
        "w": 12,
        "h": 8,
        "x": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"todayit-api\",area=\"heap\"})",
          "legendFormat": "힙 메모리 사용량"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "JVM 힙 메모리 사용량",
      "description": "애플리케이션이 사용하는 JVM 힙 메모리입니다.",
      "options": {
        "legend": {
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table"
        },
        "tooltip": {
          "sort": "none",
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "displayName": "CPU 사용률"
        },
        "overrides": []
      },
      "gridPos": {
        "y": 16,
        "w": 12,
        "h": 8,
        "x": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"todayit-api\"}",
          "legendFormat": "CPU 사용률"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "프로세스 CPU 사용률",
      "description": "애플리케이션 프로세스의 CPU 사용률입니다.",
      "options": {
        "legend": {
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table"
        },
        "tooltip": {
          "sort": "none",
          "mode": "single"
        }
      }
    }
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "title": "Todayit API 모니터링",
  "uid": "todayit-api"
}
